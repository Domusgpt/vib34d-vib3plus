      "      color: ${3:Colors.purple},",
      "      strokeWidth: ${4:2.5},",
      "    );",
      "  }",
      "",
      "  @override",
      "  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;",
      "}$0"
    ],
    "description": "Create tesseract CustomPainter"
  },
